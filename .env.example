# ============================================================
# meeseek — secrets
# ============================================================
# Copy to `.env` and fill in. Non-secret config goes in `project.yaml`.
#
# Google needs nothing here: Gemini (Vertex), managed MCP, Drive, Gmail and Chat
# all go through ADC (`./scripts/setup.sh` runs the login).
# GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION /
# GCP_PROJECT_ID / GITLAB_URL are exported from project.yaml by the loader, so
# the SDKs and MCP servers read the same values the app does — do not set them
# here. A pack (project.yaml mcp_servers.<name>.pack) gets its settings from
# its `config:` and its secrets from here.
# ============================================================

# --- Atlassian (Jira + Confluence) ---
# One account and one API token serve both the Jira pack and mcp-atlassian.
# The URLs are for mcp-atlassian (its args in project.yaml); Atlassian Cloud
# serves Confluence under the Jira site.
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_URL=https://your-org.atlassian.net
CONFLUENCE_URL=https://your-org.atlassian.net/wiki

# --- GitLab ---
# Personal Access Token. The repos the agents can reach are limited by
# project.yaml gitlab.projects, whatever the token can see.
# Scopes: read_api + read_repository for reading (the host git mirror fetches
# with it); api to post MR comments and edit MRs.
GITLAB_TOKEN=your_gitlab_personal_access_token

# --- Phone messenger (optional; project.yaml messengers) ---
# Telegram: a bot from @BotFather.
# TELEGRAM_BOT_TOKEN=

# --- Gemini API instead of Vertex (optional) ---
# With project.yaml google_cloud.vertex: false.
# GEMINI_API_KEY=your_key

# --- Optional ---
# PROJECT_CONFIG=/path/to/project.yaml   # another config file (default ./project.yaml)
# AGENT_IMAGE_ROOTS=/a/dir:/b/dir        # where MCP image_paths may point; replaces the default
#                                        # (repo, tmp, ~/Desktop, ~/Downloads, ~/Pictures); empty disables

# --- AWS Bedrock (optional: only for a bedrock/... model id; also `uv sync --extra bedrock`) ---
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# --- Where your context lives (optional) ---
# Your knowledge base, notes, stores and caches go under MEESEEK_HOME
# (knowledge_base/ and .cache/ inside it); the skills meeseek reads and learns
# into are MEESEEK_SKILLS. Both default to this checkout. Point them at a
# folder of your own to keep your context apart from the code, and portable.
# MEESEEK_HOME=~/meeseek
# MEESEEK_SKILLS=~/meeseek/skills

# --- Model gateway (optional; project.yaml models.gateway) ---
# The key an OpenAI-compatible gateway expects, when models.gateway is set.
# MODEL_GATEWAY_KEY=
